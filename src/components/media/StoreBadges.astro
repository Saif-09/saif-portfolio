---
import type { ProjectLink } from '../../data/projects';

interface Props {
  links: ProjectLink[];
}

const { links } = Astro.props;
const ios = links.find((l) => l.label === 'iOS');
const android = links.find((l) => l.label === 'Android' || l.label === 'App');
---

{
  (ios || android) && (
    <div class="store-ctas">
      {ios && (
        <a class="store-cta" href={ios.href} rel="noopener" aria-label="Download on the App Store">
          <svg class="store-cta-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor">
            <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" />
          </svg>
          <span>App Store</span>
        </a>
      )}
      {android && (
        <a class="store-cta" href={android.href} rel="noopener" aria-label="Get it on Google Play">
          <svg class="store-cta-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor">
            <path d="M3.6 1.3a1 1 0 0 0-.6.93v19.54a1 1 0 0 0 .6.93l10.35-10.7L3.6 1.3zm11.4 9.3 2.86-2.96-9.9-5.6a1 1 0 0 0-.5-.13l7.54 8.69zm0 2.8L7.46 22.1a1 1 0 0 0 .5-.13l9.9-5.6L15 13.4zm5.5-3.2-2.5-1.42-3.1 3.22 3.1 3.2 2.5-1.4a1.28 1.28 0 0 0 0-2.2z" />
          </svg>
          <span>Google Play</span>
        </a>
      )}
    </div>
  )
}

<style>
  .store-ctas {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    max-inline-size: 24rem;
  }

  /* Minimal monochrome pills, matching the .chip language. Both share
     width (flex: 1 1 0) so the two CTAs are always the same size. */
  .store-cta {
    flex: 1 1 0;
    min-inline-size: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding-block: var(--space-2);
    padding-inline: var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background-color: var(--bg);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 150ms ease-in-out,
      border-color 150ms ease-in-out;
  }

  .store-cta:hover {
    border-color: var(--muted);
  }

  .store-cta-icon {
    inline-size: 16px;
    block-size: 16px;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .store-cta:hover {
      transform: translateY(-1px);
    }
  }
</style>
