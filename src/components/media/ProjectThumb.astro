---
import PhoneFrame from './PhoneFrame.astro';
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const visual = project.visual;
---

<div class="thumb" aria-hidden={visual.type === 'tile' ? 'true' : undefined}>
  {
    visual.type === 'shot' ? (
      <img
        src={visual.thumb}
        alt={visual.alt}
        loading="lazy"
        decoding="async"
        width="480"
        height="300"
      />
    ) : visual.type === 'phone' ? (
      <div class="thumb-phone-stage">
        <PhoneFrame screen={visual.screen} name={project.name} small />
      </div>
    ) : (
      <div class="thumb-tile">
        <span>{project.name.slice(0, 1)}</span>
      </div>
    )
  }
</div>

<style>
  .thumb {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--line);
    background-color: var(--bg);
    aspect-ratio: 16 / 10;
  }

  .thumb img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: top;
  }

  .thumb-phone-stage {
    block-size: 100%;
    display: flex;
    justify-content: center;
    padding-block-start: var(--space-4);
    overflow: hidden;
    background:
      radial-gradient(
        80% 60% at 50% 0%,
        color-mix(in oklab, var(--muted) 12%, transparent),
        transparent 75%
      );
  }

  .thumb-tile {
    block-size: 100%;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 550;
    color: var(--muted);
    background:
      radial-gradient(
        70% 70% at 30% 20%,
        color-mix(in oklab, var(--muted) 14%, transparent),
        transparent 70%
      );
  }
</style>
