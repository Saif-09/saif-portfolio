---
import MiniGraph from './graph/MiniGraph';
import { useTranslations, pathForLocale, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const brainHref = pathForLocale(locale, '/brain/');
const brainBase = pathForLocale(locale, '/brain').replace(/\/$/, '');
---

{/* Section 07. Sections 05 (live demo) and 06 (analytics) slot in above
    this one in later phases. */}
<section id="open" class="open">
  <div class="container open-inner">
    <div class="open-copy">
      <h2 class="section-heading" data-reveal>{t.open.heading}</h2>
      <p class="open-lead" data-reveal>{t.open.lead}</p>
      <p class="open-cta-line" data-reveal>
        <a class="open-cta" href={brainHref}>
          {t.open.cta}
          <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
    <div class="open-graph" data-reveal data-parallax>
      <MiniGraph client:visible basePath={brainBase} />
    </div>
  </div>
</section>

<style>
  .open {
    padding-block: var(--space-16);
    border-block-start: 1px solid var(--line);
  }

  .open-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 48rem) {
    .open-inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-16);
    }
  }

  .open-lead {
    margin-block-start: var(--space-4);
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 450;
    text-wrap: balance;
  }

  .open-cta-line {
    margin-block-start: var(--space-8);
  }

  .open-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ink);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-color: var(--muted);
  }

  .open-cta:hover {
    text-decoration-color: var(--ink);
  }

  [dir='rtl'] .open-cta span {
    transform: scaleX(-1);
  }
</style>
