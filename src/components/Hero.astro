---
import { useTranslations, pathForLocale, type Locale } from '../i18n';
import HeroField from './hero/HeroField';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const workHref = pathForLocale(locale, '/work/');
const contactHref = pathForLocale(locale, '/contact/');
const nameLines = t.site.name.split(' ');
---

<section class="hero">
  {/* DEAD → ALIVE field. The CSS dot-matrix below is the permanent dormant
      fallback; HeroField only mounts WebGL over it on capable desktops,
      after LCP (D016 capability gate). */}
  <div id="hero-webgl-mount" class="hero-canvas" aria-hidden="true">
    <HeroField client:idle />
  </div>

  <div class="container hero-inner">
    <p class="eyebrow hero-eyebrow">{t.hero.eyebrow}</p>
    <h1 class="hero-name">
      {nameLines.map((line) => <span class="hero-line"><b>{line}</b></span>)}
    </h1>
    <div class="hero-subrow">
      <p class="hero-tag" set:html={t.hero.tagHtml} />
      <div class="hero-ctas">
        <a class="form-submit hero-btn" href={workHref}>{t.hero.ctaWork}</a>
        <a class="form-submit form-submit--ghost hero-btn" href={contactHref}>
          <span data-magnetic class="hero-btn-magnet">
            {t.hero.ctaContact}
            <span aria-hidden="true">→</span>
          </span>
        </a>
      </div>
    </div>
  </div>

  <p class="hero-glhint" aria-hidden="true">{t.hero.fieldHint}</p>
</section>

<style>
  .hero {
    position: relative;
    border-block-end: 1px solid var(--line);
    overflow: clip;
  }

  /* CSS-only curtain: the hero sticks while the page scrolls over it.
     Pure layout primitive - nothing for navigation or timing to corrupt. */
  @media (min-width: 64rem) {
    .hero {
      position: sticky;
      inset-block-start: 0;
      z-index: 0;
    }
  }

  /* Dormant dot-matrix - the "dead" state, and the permanent fallback. */
  .hero-canvas {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    inline-size: 46%;
    pointer-events: none;
    background-image: radial-gradient(
      color-mix(in oklab, var(--ink) 26%, transparent) 1.2px,
      transparent 1.4px
    );
    background-size: 17px 17px;
    mask-image: linear-gradient(to var(--mask-dir, right), transparent, black 22%);
  }

  [dir='rtl'] .hero-canvas {
    --mask-dir: left;
  }

  @media (max-width: 53.9rem) {
    .hero-canvas {
      display: none;
    }
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-block-size: min(86vh, 52rem);
    padding-block: var(--space-12);
  }

  .hero-eyebrow {
    margin-block-end: var(--space-6);
  }

  @media (min-width: 64rem) {
    .hero-eyebrow {
      white-space: nowrap;
    }
  }

  .hero-name {
    font-size: var(--text-display);
  }

  .hero-line {
    display: block;
    overflow: hidden;
  }

  .hero-line b {
    display: block;
    font-weight: 400;
  }

  .hero-subrow {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-8);
    flex-wrap: wrap;
    margin-block-start: var(--space-8);
  }

  .hero-tag {
    font-size: clamp(1.2rem, 2.4vw, 2rem);
    font-weight: 500;
    max-inline-size: 18ch;
    /* Roomy enough that the thick underline on the bold word never touches
       the next wrapped line - matters most in Indic/Arabic scripts. */
    line-height: 1.4;
  }

  .hero-tag :global(b) {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 4px;
    text-underline-offset: 5px;
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    flex-wrap: wrap;
  }

  .hero-btn {
    text-decoration: none;
    display: inline-block;
    white-space: nowrap;
  }

  .hero-btn-magnet {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  [dir='rtl'] .hero-btn-magnet span,
  [dir='rtl'] .hero-tag :global(span[aria-hidden]) {
    transform: scaleX(-1);
    display: inline-block;
  }

  .hero-glhint {
    position: absolute;
    z-index: 2;
    inset-block-end: var(--space-6);
    inset-inline-end: var(--grid-gutter);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero-glhint:lang(ar),
  .hero-glhint:lang(ur) {
    letter-spacing: 0;
  }

  @media (max-width: 53.9rem) {
    .hero-glhint {
      display: none;
    }
  }

  /* Entrance - pure CSS, transform-only on the name lines so the h1
     stays the LCP candidate. Reduced motion removes it entirely. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-line b {
      transform: translateY(102%);
      animation: hero-line-rise 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .hero-line:nth-child(2) b {
      animation-delay: 120ms;
    }

    .hero-line:nth-child(3) b {
      animation-delay: 240ms;
    }

    .hero-eyebrow,
    .hero-subrow {
      animation: hero-fade 0.8s cubic-bezier(0.16, 1, 0.3, 1) 300ms both;
    }
  }

  @keyframes hero-line-rise {
    to {
      transform: none;
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(20px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
