---
import Base from '../../layouts/Base.astro';
import BrainGraph from '../graph/BrainGraph';
import { useTranslations, pathForLocale, type Locale } from '../../i18n';
import { getBrainNotes, NOTE_TYPES } from '../../lib/brain';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const notes = await getBrainNotes();

const groups = NOTE_TYPES.map(({ type }) => ({
  type,
  label: t.brain.types[type as keyof typeof t.brain.types] ?? type,
  notes: notes
    .filter((n) => n.type === type)
    .sort((a, b) => a.title.localeCompare(b.title)),
})).filter((g) => g.notes.length > 0);
---

<Base
  locale={locale}
  title={`${t.brain.title} · ${t.site.name}`}
  description={t.brain.description}
>
  <div class="brain container">
    <header class="brain-header">
      <h1 class="brain-title">{t.brain.title}</h1>
      <p class="brain-lead">{t.brain.lead}</p>
    </header>

    {/* Decorative, interactive graph. The typed list below remains the
        accessible, crawlable path through the vault. */}
    <div id="brain-graph-mount" class="brain-graph-mount">
      <BrainGraph
        client:visible
        basePath={pathForLocale(locale, '/brain').replace(/\/$/, '')}
        searchLabel={t.brain.graphSearchLabel}
        searchPlaceholder={t.brain.graphSearchPlaceholder}
        legendLabel={t.brain.legendLabel}
        typeLabels={t.brain.types}
      />
    </div>

    <div class="brain-groups">
      {
        groups.map((group) => (
          <section class="brain-group" aria-labelledby={`type-${group.type}`} data-reveal>
            <h2 class="brain-group-heading" id={`type-${group.type}`}>
              {group.label}
              <span class="brain-count">{group.notes.length}</span>
            </h2>
            <ul class="brain-list" role="list">
              {group.notes.map((note) => (
                <li class="brain-item">
                  <a href={pathForLocale(locale, `/brain/${note.slug}/`)}>
                    <span class="brain-item-title">{note.title}</span>
                    {note.excerpt && (
                      <span class="brain-item-excerpt">{note.excerpt}</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .brain {
    padding-block: var(--space-16) var(--space-24);
  }

  .brain-title {
    font-size: var(--text-h1);
  }

  .brain-lead {
    margin-block-start: var(--space-4);
    color: var(--muted);
    max-inline-size: var(--measure);
  }

  .brain-graph-mount {
    margin-block-start: var(--space-8);
  }

  .brain-groups {
    margin-block-start: var(--space-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .brain-group-heading {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-size: 1.25rem;
    border-block-end: 1px solid var(--line);
    padding-block-end: var(--space-3);
  }

  .brain-count {
    color: var(--muted);
    font-family: var(--font-text);
    font-size: var(--text-small);
  }

  .brain-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    margin-block-start: var(--space-4);
  }

  @media (min-width: 48rem) {
    .brain-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3) var(--grid-gutter);
    }
  }

  .brain-item a {
    display: block;
    padding: var(--space-3) var(--space-4);
    border: 1px solid transparent;
    border-radius: 10px;
    text-decoration: none;
    color: var(--ink);
  }

  .brain-item a:hover {
    background-color: var(--surface);
    border-color: var(--line);
  }

  .brain-item-title {
    display: block;
    font-weight: 500;
  }

  .brain-item-excerpt {
    display: block;
    color: var(--muted);
    font-size: var(--text-small);
    margin-block-start: 2px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
