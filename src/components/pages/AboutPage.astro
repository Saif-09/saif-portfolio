---
import Base from '../../layouts/Base.astro';
import Marquee from '../Marquee.astro';
import { profile } from '../../data/profile';
import {
  story,
  skillGroups,
  principles,
  foundingHeading,
  foundingLead,
  foundingReasons,
  faqs,
} from '../../data/about';
import { useTranslations, pathForLocale, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  locale={locale}
  title={`${t.nav.about} · ${t.site.name}`}
  description={t.site.description}
  jsonLd={[faqJsonLd]}
>
  <div class="about-page container">
    <header class="page-header">
      <h1 class="sec-label">
        <span class="sec-n" aria-hidden="true">(02)</span><br />
        {t.about.heading}
      </h1>
    </header>

    <div class="about-grid">
      <div class="about-story" data-reveal>
        {story.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <div class="about-side" data-reveal>
        <h2 class="about-side-heading">{t.how.stackNote}</h2>
        <div class="skill-groups">
          {
            skillGroups.map((group) => (
              <div class="skill-group">
                <h3 class="skill-group-label">{group.label}</h3>
                <ul class="tech-list" role="list">
                  {group.items.map((item) => (
                    <li class="tech-item">{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="about-marquee">
      <Marquee
        items={['React Native', 'React', 'Next.js', 'TypeScript', 'Node.js', 'Firebase', 'Postgres', 'Socket.IO', 'AI']}
      />
    </div>

    <section class="about-how" aria-labelledby="how-heading">
      <h2 class="sec-label about-how-label" id="how-heading" data-split>{t.how.heading}</h2>
      <ol class="principles" role="list">
        {
          principles.map((principle, index) => (
            <li class="principle" data-reveal>
              <span class="principle-index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="principle-title">{principle.title}</h3>
              <p class="principle-body">{principle.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="about-founding" aria-labelledby="founding-heading">
      <h2 class="sec-label about-how-label" id="founding-heading" data-split>
        {foundingHeading}
      </h2>
      <p class="founding-lead" data-reveal>{foundingLead}</p>
      <ul class="founding-list" role="list">
        {
          foundingReasons.map((reason) => (
            <li class="founding-item" data-reveal>
              <span class="founding-tick" aria-hidden="true">→</span>
              <p>
                <strong>{reason.lead}</strong> {reason.body}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="about-faq" aria-labelledby="faq-heading">
      <h2 class="sec-label about-how-label" id="faq-heading" data-split>FAQ</h2>
      <div class="faq-list">
        {
          faqs.map((faq, index) => (
            <details class="faq-item" data-reveal open={index === 0}>
              <summary class="faq-q">
                <span>{faq.q}</span>
                <span class="faq-mark" aria-hidden="true" />
              </summary>
              <p class="faq-a">{faq.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <p class="about-cta" data-reveal>
      <a class="open-cta" href={pathForLocale(locale, '/contact/')}>
        {t.hero.ctaContact}
        <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</Base>

<style>
  .about-page {
    padding-block: var(--space-12) var(--space-16);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    margin-block-start: var(--space-8);
  }

  @media (min-width: 48rem) {
    .about-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: var(--space-16);
    }
  }

  .about-story {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .about-side-heading {
    font-size: var(--text-small);
    font-family: var(--font-text);
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-block-end: var(--space-4);
  }

  .about-side-heading:lang(ar),
  .about-side-heading:lang(ur) {
    letter-spacing: 0;
  }

  .skill-groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .skill-group-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    margin-block-end: var(--space-3);
  }

  .skill-group-label:lang(ar),
  .skill-group-label:lang(ur) {
    letter-spacing: 0;
    font-size: 0.9rem;
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tech-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding-block: var(--space-1);
    padding-inline: var(--space-3);
    font-size: var(--text-small);
    background-color: var(--surface);
  }

  /* Full-bleed from inside the centered container: span the viewport,
     not just the container's gutters. */
  .about-marquee {
    margin-block-start: var(--space-16);
    inline-size: 100vw;
    margin-inline-start: calc(50% - 50vw);
  }

  .about-how {
    margin-block-start: var(--space-16);
  }

  .about-how-label {
    margin-block-end: var(--space-8);
  }

  .principles {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--grid-gutter);
  }

  @media (min-width: 48rem) {
    .principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .principle {
    border-block-start: 1px solid var(--line);
    padding-block-start: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .principle-index {
    font-family: var(--font-display);
    color: var(--muted);
    font-size: var(--text-small);
  }

  .principle-title {
    font-size: 1.25rem;
    font-weight: 550;
  }

  .principle-body {
    color: var(--muted);
  }

  .about-founding {
    margin-block-start: var(--space-16);
  }

  .founding-lead {
    margin-block: var(--space-8) var(--space-8);
    font-size: 1.25rem;
    font-weight: 500;
    max-inline-size: 52ch;
    line-height: 1.4;
  }

  .founding-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 48rem) {
    .founding-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6) var(--space-12);
    }
  }

  .founding-item {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .founding-item p {
    max-inline-size: 52ch;
  }

  .founding-item strong {
    font-weight: 650;
  }

  .founding-tick {
    color: var(--muted);
    line-height: 1.5;
    flex-shrink: 0;
  }

  [dir='rtl'] .founding-tick {
    transform: scaleX(-1);
  }

  .about-faq {
    margin-block-start: var(--space-16);
  }

  .faq-list {
    margin-block-start: var(--space-8);
    border-block-start: 1px solid var(--line);
  }

  .faq-item {
    border-block-end: 1px solid var(--line);
  }

  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: var(--space-4);
    font-size: 1.15rem;
    font-weight: 550;
    cursor: pointer;
    list-style: none;
  }

  .faq-q::-webkit-details-marker {
    display: none;
  }

  /* Plus/minus glyph built from pseudo-elements so it animates cleanly. */
  .faq-mark {
    position: relative;
    inline-size: 1rem;
    block-size: 1rem;
    flex-shrink: 0;
  }

  .faq-mark::before,
  .faq-mark::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    background-color: var(--ink);
    transform: translate(-50%, -50%);
    transition: opacity 0.2s ease;
  }

  .faq-mark::before {
    inline-size: 1rem;
    block-size: 2px;
  }

  .faq-mark::after {
    inline-size: 2px;
    block-size: 1rem;
  }

  .faq-item[open] .faq-mark::after {
    opacity: 0;
  }

  .faq-a {
    color: var(--muted);
    max-inline-size: 68ch;
    padding-block-end: var(--space-5);
    line-height: 1.6;
  }

  .about-cta {
    margin-block-start: var(--space-12);
  }

  [dir='rtl'] .open-cta span {
    transform: scaleX(-1);
  }
</style>
