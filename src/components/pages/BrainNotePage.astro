---
import Base from '../../layouts/Base.astro';
import {
  DEFAULT_LOCALE,
  useTranslations,
  pathForLocale,
  type Locale,
} from '../../i18n';
import { getBrainNotes, getLocalizedNoteHtml, type BrainNote } from '../../lib/brain';

interface Props {
  locale: Locale;
  note: BrainNote;
}

const { locale, note } = Astro.props;
const t = useTranslations(locale);

/* Reviewed machine translation if one exists (D006 gate), else English. */
const localizedHtml =
  locale === DEFAULT_LOCALE ? undefined : await getLocalizedNoteHtml(locale, note.slug);
const baseHtml = localizedHtml ?? note.html;

/* Keep in-body wikilinks inside the active locale. */
const noteHtml =
  locale === DEFAULT_LOCALE
    ? baseHtml
    : baseHtml.replaceAll('href="/brain/', `href="/${locale}/brain/`);
const all = await getBrainNotes();
const backlinks = note.backlinks
  .map((slug) => all.find((n) => n.slug === slug))
  .filter((n): n is BrainNote => Boolean(n));

const description = note.excerpt || t.brain.description;
---

<Base
  locale={locale}
  title={`${note.title} · ${t.brain.title} · ${t.site.name}`}
  description={description}
>
  <article class="note container">
    <header class="note-header">
      <p class="note-eyebrow">
        <a href={pathForLocale(locale, '/brain/')}>{t.brain.title}</a>
        <span aria-hidden="true"> / </span>
        <span class="note-type">{
          t.brain.types[note.type as keyof typeof t.brain.types] ?? note.type
        }</span>
      </p>
      {note.created && <p class="note-date">{note.created}</p>}
    </header>

    {/* The note's own H1 comes from its markdown body. */}
    <div class="prose note-body" set:html={noteHtml} />

    <aside class="backlinks" aria-labelledby="backlinks-heading">
      <h2 class="backlinks-heading" id="backlinks-heading">
        {t.brain.backlinks}
      </h2>
      {
        backlinks.length > 0 ? (
          <ul class="backlinks-list" role="list">
            {backlinks.map((source) => (
              <li>
                <a href={pathForLocale(locale, `/brain/${source.slug}/`)}>
                  <span class="backlink-title">{source.title}</span>
                  {source.excerpt && (
                    <span class="backlink-excerpt">{source.excerpt}</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="backlinks-empty">{t.brain.noBacklinks}</p>
        )
      }
    </aside>

    <p class="note-back">
      <a href={pathForLocale(locale, '/brain/')}>← {t.brain.backToIndex}</a>
    </p>
  </article>
</Base>

<style>
  .note {
    padding-block: var(--space-16) var(--space-24);
  }

  .note-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    margin-block-end: var(--space-8);
  }

  .note-eyebrow {
    font-size: var(--text-small);
    color: var(--muted);
  }

  .note-eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .note-eyebrow a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .note-date {
    color: var(--muted);
    font-size: var(--text-small);
    font-variant-numeric: tabular-nums;
  }

  .backlinks {
    margin-block-start: var(--space-16);
    border: 1px solid var(--line);
    border-radius: 16px;
    background-color: var(--surface);
    padding: var(--space-6);
    max-inline-size: var(--measure);
  }

  .backlinks-heading {
    font-size: var(--text-small);
    font-family: var(--font-text);
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .backlinks-heading:lang(ar),
  .backlinks-heading:lang(ur) {
    letter-spacing: 0;
  }

  .backlinks-list {
    margin-block-start: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .backlinks-list a {
    display: block;
    text-decoration: none;
    color: var(--ink);
    border-radius: 8px;
    padding: var(--space-2) var(--space-3);
    margin-inline: calc(-1 * var(--space-3));
  }

  .backlinks-list a:hover {
    background-color: var(--bg);
  }

  .backlink-title {
    display: block;
    font-weight: 500;
  }

  .backlink-excerpt {
    display: block;
    color: var(--muted);
    font-size: var(--text-small);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .backlinks-empty {
    margin-block-start: var(--space-3);
    color: var(--muted);
    font-size: var(--text-small);
  }

  .note-back {
    margin-block-start: var(--space-12);
  }

  .note-back a {
    color: var(--muted);
    text-decoration: none;
    font-size: var(--text-small);
  }

  .note-back a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
