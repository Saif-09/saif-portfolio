---
/**
 * /studio : the private resume control panel.
 *
 * Deliberately not on Base.astro. No nav, no footer, no locale switcher, no
 * analytics tracker: this is a tool, not a page of the portfolio. It is also
 * kept out of the sitemap (see astro.config.mjs) and noindexed, and every API
 * route behind it needs the studio key.
 */
import '../styles/tokens.css';
import ResumeStudio from '../components/studio/ResumeStudio';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Resume studio</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <ResumeStudio client:only="react" />

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: var(--space-4);
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-text);
        line-height: 1.45;
        -webkit-text-size-adjust: 100%;
      }

      .studio-muted {
        color: var(--muted);
        font-size: var(--text-small);
      }

      .studio-error,
      .studio-ok {
        font-size: var(--text-small);
        border: 1px solid var(--line);
        border-inline-start-width: 3px;
        padding: var(--space-2) var(--space-3);
        margin: var(--space-2) 0;
        background: var(--surface);
      }

      .studio-error {
        border-inline-start-color: #b3261e;
      }

      .studio-ok {
        border-inline-start-color: #1b7f4c;
      }

      /* ------------------------------------------------------------- gate */

      .studio-gate {
        max-width: 26rem;
        margin: 12vh auto;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
      }

      .studio-gate h2 {
        font-family: var(--font-display);
        font-weight: 400;
        margin: 0;
      }

      .studio-gate input,
      .studio textarea {
        font-family: var(--font-mono);
        font-size: 0.9rem;
        color: var(--ink);
        background: var(--bg);
        border: 1px solid var(--line);
        padding: var(--space-2) var(--space-3);
        width: 100%;
      }

      .studio-gate button,
      .studio button {
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: var(--space-2) var(--space-4);
        border: 1px solid var(--ink);
        background: var(--ink);
        color: var(--bg);
        cursor: pointer;
      }

      .studio button:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }

      .studio .studio-ghost {
        background: transparent;
        color: var(--ink);
        border-color: var(--line);
      }

      /* ------------------------------------------------------------ shell */

      .studio {
        max-width: 108rem;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
      }

      .studio-head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        padding-block-end: var(--space-3);
        border-block-end: 1px solid var(--line);
      }

      .studio-head-left,
      .studio-head-right {
        display: flex;
        align-items: center;
        gap: var(--space-3);
      }

      .studio-head h1 {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 1.35rem;
        margin: 0;
      }

      .studio-pill,
      .studio-dirty {
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        border: 1px solid var(--line);
        border-radius: var(--radius-pill);
        padding: 0.15em 0.7em;
        white-space: nowrap;
      }

      .studio-pill-ok {
        border-color: #1b7f4c;
        color: #1b7f4c;
      }

      .studio-pill-bad {
        border-color: #b3261e;
        color: #b3261e;
      }

      .studio-pill-busy {
        border-color: var(--accent);
        color: var(--accent-ink, var(--ink));
        background: var(--accent);
      }

      .studio-dirty {
        color: var(--muted);
        border-style: dashed;
      }

      /* ------------------------------------------------------------- tabs */

      .studio-tabs,
      .studio-panetabs {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
      }

      .studio-tabs button,
      .studio-panetabs button {
        background: transparent;
        color: var(--muted);
        border-color: var(--line);
      }

      .studio-tabs button.is-active,
      .studio-panetabs button.is-active {
        background: var(--ink);
        color: var(--bg);
        border-color: var(--ink);
      }

      /* The Preview/Edit switch only exists on narrow screens, where both
         columns cannot sit side by side. */
      .studio-panetabs {
        display: none;
      }

      /* ------------------------------------------------------------- grid */

      .studio-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: var(--space-4);
        align-items: start;
      }

      .studio-col {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
      }

      .studio-meta {
        font-size: var(--text-small);
        color: var(--muted);
        margin: 0;
      }

      .studio-pdf {
        width: 100%;
        aspect-ratio: 8.5 / 11;
        border: 1px solid var(--line);
        background: var(--surface);
      }

      .studio-note {
        margin: 0;
      }

      .studio-all {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-3);
      }

      .studio-all figure {
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
        min-width: 0;
      }

      .studio-all figcaption {
        display: flex;
        justify-content: space-between;
        gap: var(--space-2);
        font-size: var(--text-small);
      }

      .studio-all iframe {
        width: 100%;
        aspect-ratio: 8.5 / 11;
        border: 1px solid var(--line);
        background: var(--surface);
      }

      /* --------------------------------------------------------------- ai */

      .studio-ai {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
      }

      .studio-ai label,
      .studio-source-label {
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
      }

      .studio-ai-actions {
        display: flex;
        gap: var(--space-2);
      }

      .studio-result {
        border: 1px solid var(--line);
        background: var(--surface);
        padding: var(--space-3);
        font-size: var(--text-small);
      }

      .studio-result-note {
        margin: 0 0 var(--space-2);
      }

      .studio-result summary {
        cursor: pointer;
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
      }

      .studio-result ul {
        list-style: none;
        margin: var(--space-2) 0 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
      }

      .studio-result li p {
        margin: 0 0 var(--space-1);
      }

      .studio-result pre {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        margin: 0 0 var(--space-1);
        padding: var(--space-2);
        border-inline-start: 3px solid var(--line);
        background: var(--bg);
      }

      .studio-del {
        border-inline-start-color: #b3261e !important;
      }

      .studio-ins {
        border-inline-start-color: #1b7f4c !important;
      }

      /* ----------------------------------------------------------- source */

      .studio-source {
        min-height: 60vh;
        resize: vertical;
        line-height: 1.5;
        tab-size: 2;
      }

      /* ------------------------------------------------------- responsive */

      @media (max-width: 60rem) {
        .studio-grid {
          grid-template-columns: minmax(0, 1fr);
        }

        .studio-panetabs {
          display: flex;
        }

        /* One column at a time on a phone, chosen by the Preview/Edit tabs. */
        .studio-col {
          display: none;
        }

        .studio-col.is-shown {
          display: flex;
        }

        .studio-all {
          grid-template-columns: 1fr;
        }

        .studio-source {
          min-height: 55vh;
        }
      }
    </style>
  </body>
</html>
