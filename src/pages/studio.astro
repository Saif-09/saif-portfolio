---
/**
 * /studio : the private resume control panel.
 *
 * Deliberately not on Base.astro. No nav, no footer, no locale switcher, no
 * analytics tracker: this is a tool, not a page of the portfolio. It is also
 * kept out of the sitemap (see astro.config.mjs) and noindexed, and every API
 * route behind it needs the studio key.
 */
import '../styles/tokens.css';
import StudioApp from '../components/studio/StudioApp';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Resume studio</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <StudioApp client:only="react" />

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: var(--space-4);
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-text);
        line-height: 1.45;
        -webkit-text-size-adjust: 100%;
      }

      .studio-muted {
        color: var(--muted);
        font-size: var(--text-small);
      }

      .studio-error,
      .studio-ok {
        font-size: var(--text-small);
        border: 1px solid var(--line);
        border-inline-start-width: 3px;
        padding: var(--space-2) var(--space-3);
        margin: var(--space-2) 0;
        background: var(--surface);
      }

      .studio-error {
        border-inline-start-color: #b3261e;
      }

      .studio-ok {
        border-inline-start-color: #1b7f4c;
      }

      /* ------------------------------------------------------------- gate */

      .studio-gate {
        max-width: 26rem;
        margin: 12vh auto;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
      }

      .studio-gate h2 {
        font-family: var(--font-display);
        font-weight: 400;
        margin: 0;
      }

      .studio-gate input,
      .studio textarea {
        font-family: var(--font-mono);
        font-size: 0.9rem;
        color: var(--ink);
        background: var(--bg);
        border: 1px solid var(--line);
        padding: var(--space-2) var(--space-3);
        width: 100%;
      }

      .studio-gate button,
      .studio button {
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: var(--space-2) var(--space-4);
        border: 1px solid var(--ink);
        background: var(--ink);
        color: var(--bg);
        cursor: pointer;
      }

      .studio button:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }

      .studio .studio-ghost {
        background: transparent;
        color: var(--ink);
        border-color: var(--line);
      }

      /* --------------------------------------------------------- app tabs */

      /* This page does not import global.css, so the utility it relies on has
         to exist here or the label renders as visible text. */
      .sr-only {
        position: absolute;
        inline-size: 1px;
        block-size: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
      }

      .studio-apps {
        display: flex;
        gap: var(--space-2);
        margin-block-end: var(--space-4);
      }

      /* Fully specified rather than inheriting: the app tabs sit in
         .studio-app, outside .studio, so the base `.studio button` rule never
         reached them and they rendered as default browser buttons. */
      .studio-apps button {
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: var(--space-2) var(--space-4);
        border: 1px solid var(--line);
        background: transparent;
        color: var(--muted);
        cursor: pointer;
      }

      .studio-apps button.is-active {
        background: var(--ink);
        color: var(--bg);
        border-color: var(--ink);
      }

      /* ----------------------------------------------------------- apply */
      /* Built thumb-first: this is used standing up, on a phone, in the
         minute between seeing a post and deciding to apply. */

      .apply {
        max-width: 108rem;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
      }

      .apply-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-3);
      }

      /* The empty state IS the interface here, so it gets the whole width and
         says what to do. A lone button in the corner of a black page reads as
         a broken screen. */
      .apply-intake {
        max-width: 42rem;
        margin: 0 auto;
        padding-block: clamp(var(--space-6), 6vh, var(--space-16));
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
      }

      .apply-drop {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--space-2);
        min-block-size: 34vh;
        padding: var(--space-8);
        border: 1px dashed var(--line);
        border-radius: 16px;
        background: var(--surface);
        text-align: center;
        cursor: pointer;
        transition: border-color 0.15s ease, background-color 0.15s ease;
      }

      .apply-drop:hover,
      .apply-drop:focus-visible,
      .apply-drop.is-dragging {
        border-color: var(--ink);
        border-style: solid;
      }

      .apply-drop.is-busy {
        cursor: progress;
        border-color: var(--accent);
      }

      .apply-drop-title {
        margin: 0;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(1.1rem, 2.4vw, 1.5rem);
        color: var(--ink);
      }

      .apply-drop-sub {
        margin: 0;
        color: var(--muted);
        font-size: var(--text-small);
      }

      .apply-or {
        margin: 0;
        text-align: center;
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
      }

      .apply-url {
        display: flex;
        gap: var(--space-2);
      }

      .apply .apply-url input {
        flex: 1 1 auto;
        min-width: 0;
        font-family: var(--font-mono);
        font-size: 0.9rem;
        color: var(--ink);
        background: var(--bg);
        border: 1px solid var(--line);
        padding: var(--space-2) var(--space-3);
      }

      .apply-hint {
        margin: 0;
        text-align: center;
      }

      .apply-paste summary {
        cursor: pointer;
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
        text-align: center;
      }

      .apply-paste textarea {
        inline-size: 100%;
        margin-block: var(--space-3) var(--space-2);
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--ink);
        background: var(--bg);
        border: 1px solid var(--line);
        padding: var(--space-2) var(--space-3);
        resize: vertical;
      }

      .apply-paste button {
        inline-size: 100%;
      }

      .apply .apply-overdue {
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #b3261e;
        border: 1px solid #b3261e;
        border-radius: var(--radius-pill);
        padding: 0.15em 0.7em;
      }

      .apply-grid {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
        gap: var(--space-4);
        align-items: start;
      }

      .apply-col {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
      }

      .apply-shot {
        inline-size: 100%;
        max-block-size: 40vh;
        object-fit: contain;
        object-position: top;
        border: 1px solid var(--line);
        background: var(--surface);
      }

      .apply-facts {
        margin: 0;
        display: grid;
        gap: var(--space-1);
        font-size: var(--text-small);
      }

      .apply-facts > div {
        display: grid;
        grid-template-columns: 9rem minmax(0, 1fr);
        gap: var(--space-3);
      }

      .apply-facts dt {
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--muted);
      }

      .apply-facts dd {
        margin: 0;
        overflow-wrap: anywhere;
      }

      .apply-musts {
        margin: 0;
        padding-inline-start: 1.1em;
        font-size: var(--text-small);
        color: var(--muted);
      }

      .apply .apply-subject,
      .apply .apply-body {
        font-family: var(--font-mono);
        font-size: 0.9rem;
        color: var(--ink);
        background: var(--bg);
        border: 1px solid var(--line);
        padding: var(--space-2) var(--space-3);
        inline-size: 100%;
      }

      .apply .apply-body {
        min-block-size: 34vh;
        resize: vertical;
        line-height: 1.55;
        white-space: pre-wrap;
      }

      .apply-send {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
      }

      /* The one action that matters, styled as such. */
      .apply .apply-primary {
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: var(--space-2) var(--space-4);
        border: 1px solid var(--ink);
        background: var(--ink);
        color: var(--bg);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
      }

      /* Sits with the send actions: attaching the PDF is part of sending. */
      .apply .apply-download {
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: var(--space-2) var(--space-4);
        border: 1px solid var(--line);
        background: transparent;
        color: var(--ink);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
      }

      .apply .apply-download:hover {
        border-color: var(--ink);
      }

      .apply-log h2 {
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
        font-weight: 400;
        margin: 0 0 var(--space-2);
      }

      .apply-log ul {
        margin: 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
      }

      .apply-log li {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-3);
        padding-block: var(--space-2);
        border-block-start: 1px solid var(--line);
        font-size: var(--text-small);
      }

      .apply-log li.is-overdue {
        border-inline-start: 3px solid #b3261e;
        padding-inline-start: var(--space-3);
      }

      .apply-log-when {
        font-family: var(--font-mono);
        color: var(--muted);
        flex: none;
      }

      .apply-log-what {
        flex: 1 1 14rem;
        min-width: 0;
      }

      .apply-log select {
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        background: var(--bg);
        color: var(--ink);
        border: 1px solid var(--line);
        padding: 0.2em 0.4em;
      }

      /* ------------------------------------------------------------ shell */

      .studio {
        max-width: 108rem;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
      }

      .studio-head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        padding-block-end: var(--space-3);
        border-block-end: 1px solid var(--line);
      }

      .studio-head-left,
      .studio-head-right {
        display: flex;
        align-items: center;
        gap: var(--space-3);
      }

      .studio-head h1 {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 1.35rem;
        margin: 0;
      }

      .studio-pill,
      .studio-dirty {
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        border: 1px solid var(--line);
        border-radius: var(--radius-pill);
        padding: 0.15em 0.7em;
        white-space: nowrap;
      }

      .studio-pill-ok {
        border-color: #1b7f4c;
        color: #1b7f4c;
      }

      .studio-pill-bad {
        border-color: #b3261e;
        color: #b3261e;
      }

      .studio-pill-busy {
        border-color: var(--accent);
        color: var(--accent-ink, var(--ink));
        background: var(--accent);
      }

      .studio-dirty {
        color: var(--muted);
        border-style: dashed;
      }

      /* ------------------------------------------------------------- tabs */

      .studio-panetabs,
      .studio-switch {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
      }

      .studio-panetabs button,
      .studio-switch button {
        background: transparent;
        color: var(--muted);
        border-color: var(--line);
      }

      .studio-panetabs button.is-active,
      .studio-switch button.is-active {
        background: var(--ink);
        color: var(--bg);
        border-color: var(--ink);
      }

      /* Which version the previews show, and whether to keep them fresh. */
      .studio-sourcebar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
      }

      .studio-auto {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
        cursor: pointer;
      }

      .studio-stale {
        margin: 0;
        font-size: var(--text-small);
        color: var(--muted);
        border-inline-start: 3px solid var(--accent);
        padding-inline-start: var(--space-3);
      }

      /* All four variants at a glance; clicking one enlarges it above. */
      .studio-thumbs {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--space-2);
      }

      /* Scoped with the parent for specificity: the generic `.studio button`
         rule above is (0,1,1) and would otherwise win over a lone
         `.studio-thumb` (0,1,0), painting these labels in --bg. */
      .studio .studio-thumb {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: var(--space-1);
        padding: var(--space-1);
        background: transparent;
        border: 1px solid var(--line);
        color: var(--muted);
        cursor: pointer;
        /* The iframe would eat the click, so the button captures it instead. */
        position: relative;
      }

      .studio .studio-thumb::after {
        content: '';
        position: absolute;
        inset: 0;
      }

      .studio .studio-thumb.is-active {
        border-color: var(--ink);
        color: var(--ink);
      }

      .studio .studio-thumb iframe {
        width: 100%;
        aspect-ratio: 8.5 / 11;
        border: 0;
        background: var(--surface);
        pointer-events: none;
      }

      .studio .studio-thumb span {
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        text-align: center;
      }

      /* The Preview/Edit switch only exists on narrow screens, where both
         columns cannot sit side by side. */
      .studio-panetabs {
        display: none;
      }

      /* ------------------------------------------------------------- grid */

      .studio-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: var(--space-4);
        align-items: start;
      }

      .studio-col {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
      }

      .studio-meta {
        font-size: var(--text-small);
        color: var(--muted);
        margin: 0;
      }

      /* Height-capped rather than letter-shaped: the thumbnail rail has to
         stay visible under it without scrolling, and the viewer fits the page
         to width anyway (view=FitH). */
      .studio-pdf {
        width: 100%;
        height: 58vh;
        min-height: 20rem;
        border: 1px solid var(--line);
        background: var(--surface);
      }

      .studio-note {
        margin: 0;
      }

      /* --------------------------------------------------------------- ai */

      .studio-ai {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
      }

      .studio-ai label,
      .studio-source-label {
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
      }

      .studio-ai-actions {
        display: flex;
        gap: var(--space-2);
      }

      .studio-result {
        border: 1px solid var(--line);
        background: var(--surface);
        padding: var(--space-3);
        font-size: var(--text-small);
      }

      .studio-result-note {
        margin: 0 0 var(--space-2);
      }

      .studio-result summary {
        cursor: pointer;
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
      }

      .studio-result ul {
        list-style: none;
        margin: var(--space-2) 0 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
      }

      .studio-result li p {
        margin: 0 0 var(--space-1);
      }

      .studio-result pre {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        margin: 0 0 var(--space-1);
        padding: var(--space-2);
        border-inline-start: 3px solid var(--line);
        background: var(--bg);
      }

      .studio-del {
        border-inline-start-color: #b3261e !important;
      }

      .studio-ins {
        border-inline-start-color: #1b7f4c !important;
      }

      /* Saving a one-off: named after the company it was written for. */
      .studio-oneoff {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-3) var(--space-4);
        border: 1px solid var(--accent);
        border-radius: 16px;
        background: var(--surface);
      }

      .studio-oneoff label {
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
      }

      .studio .studio-oneoff input {
        flex: 1 1 12rem;
        min-width: 0;
        font-family: var(--font-mono);
        font-size: 0.9rem;
        color: var(--ink);
        background: var(--bg);
        border: 1px solid var(--line);
        padding: var(--space-2) var(--space-3);
      }

      .studio-oneoff p {
        flex: 1 1 100%;
        margin: 0;
      }

      .studio-download {
        margin: 0;
        font-size: var(--text-small);
        color: var(--muted);
      }

      .studio .studio-downloadlink {
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: var(--space-2) var(--space-4);
        border: 1px solid var(--line);
        color: var(--ink);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
      }

      .studio .studio-downloadlink:hover {
        border-color: var(--ink);
      }

      .studio-download {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2);
      }

      .studio-tailored summary {
        cursor: pointer;
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
      }

      .studio-tailored ul {
        margin: var(--space-2) 0 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
        font-size: var(--text-small);
      }

      .studio-tailored li {
        display: flex;
        align-items: baseline;
        gap: var(--space-3);
      }

      .studio-tailored li a {
        flex: 1 1 auto;
        color: var(--ink);
      }

      .studio .studio-tailored button {
        background: transparent;
        border: 0;
        padding: 0;
        color: var(--muted);
        font-size: var(--text-mono);
        text-decoration: underline;
      }

      /* ------------------------------------------------------------- form */
      /* The point of this pane: edit the words without hunting for the line
         in 17,000 characters of TeX. */

      .studio-editorswitch {
        display: flex;
        align-items: center;
        gap: var(--space-2);
      }

      .studio-editorswitch button {
        background: transparent;
        color: var(--muted);
        border-color: var(--line);
      }

      .studio-editorswitch button.is-active {
        background: var(--ink);
        color: var(--bg);
        border-color: var(--ink);
      }

      .studio-form {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        max-block-size: 68vh;
        overflow-y: auto;
        padding-inline-end: var(--space-2);
      }

      .studio-fieldset {
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--surface);
      }

      .studio .studio-grouphead {
        inline-size: 100%;
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--space-3);
        padding: var(--space-2) var(--space-3);
        background: transparent;
        border: 0;
        color: var(--ink);
        text-align: start;
        cursor: pointer;
      }

      .studio-field {
        padding: var(--space-2) var(--space-3) var(--space-3);
        border-block-start: 1px solid var(--line);
      }

      .studio-field label {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--space-2);
        margin-block-end: var(--space-1);
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--muted);
      }

      .studio .studio-reveal {
        background: transparent;
        border: 0;
        padding: 0;
        color: var(--muted);
        font-size: var(--text-mono);
        text-decoration: underline;
        text-transform: none;
        letter-spacing: 0;
        cursor: pointer;
        flex: none;
      }

      .studio .studio-reveal:hover {
        color: var(--ink);
      }

      .studio .studio-field input,
      .studio .studio-field textarea {
        inline-size: 100%;
        font-family: var(--font-text);
        font-size: 0.95rem;
        line-height: 1.5;
        color: var(--ink);
        background: var(--bg);
        border: 1px solid var(--line);
        padding: var(--space-2) var(--space-3);
        resize: vertical;
      }

      .studio-fieldwarn {
        margin: var(--space-1) 0 0;
        font-size: var(--text-small);
        color: #b3261e;
      }

      /* ----------------------------------------------------------- source */

      .studio-source {
        min-height: 60vh;
        resize: vertical;
        line-height: 1.5;
        tab-size: 2;
      }

      /* ------------------------------------------------------- responsive */

      @media (max-width: 60rem) {
        .studio-grid {
          grid-template-columns: minmax(0, 1fr);
        }

        .studio-panetabs {
          display: flex;
        }

        /* One column at a time on a phone, chosen by the Preview/Edit tabs. */
        .studio-col {
          display: none;
        }

        .studio-col.is-shown {
          display: flex;
        }

        .studio-thumbs {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .apply-grid {
          grid-template-columns: minmax(0, 1fr);
        }

        .apply-facts > div {
          grid-template-columns: 7rem minmax(0, 1fr);
        }

        /* Full-width targets: this is used one-handed. */
        .apply-actions button,
        .apply-send > * {
          flex: 1 1 100%;
          justify-content: center;
        }

        .studio-source {
          min-height: 55vh;
        }
      }
    </style>
  </body>
</html>
