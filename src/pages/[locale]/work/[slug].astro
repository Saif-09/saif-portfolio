---
import CaseStudyPage from '../../../components/pages/CaseStudyPage.astro';
import { getWorkEntry, getWorkSlugs } from '../../../lib/work';
import { DEFAULT_LOCALE, LOCALES, type Locale } from '../../../i18n';

export async function getStaticPaths() {
  const slugs = await getWorkSlugs();
  return LOCALES.filter((l) => l.code !== DEFAULT_LOCALE).flatMap((l) =>
    slugs.map((slug) => ({ params: { locale: l.code, slug } })),
  );
}

const locale = Astro.params.locale as Locale;
const entry = await getWorkEntry(locale, Astro.params.slug);
if (!entry) throw new Error(`No case study for slug: ${Astro.params.slug}`);
---

<CaseStudyPage locale={locale} entry={entry} />
